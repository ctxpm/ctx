rules_version = '2';

// Artifacts are written only by the publish API. A client may download an artifact when
// the access document of the package in Firestore says it may read the package. Keep the
// functions below identical to the ones in firestore.rules.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function domain() {
      return email().split('@')[1];
    }

    function listedIn(access) {
      return signedIn() && (
        email() in access.readers
        || email() in access.maintainers
        || domain() in access.readerDomains
      );
    }

    function canRead(access) {
      return access.visibility == 'public' || listedIn(access);
    }

    match /packages/{name}/{version}/{artifact} {
      allow get: if canRead(firestore.get(/databases/(default)/documents/packages/$(name)/private/access).data);
      allow list, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
