# Used only by the Firebase emulators (project id "demo-ctx"). The emulator tests run a
# local key server on this port to stand in for the CI token issuer.
CTX_OIDC_ISSUER=http://127.0.0.1:9911
CTX_OIDC_JWKS_URL=http://127.0.0.1:9911/jwks
CTX_OIDC_AUDIENCE=ctx:demo-ctx
CTX_BUCKET=demo-ctx.firebasestorage.app
