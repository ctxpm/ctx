{
  "name": "@ctxpm/registry-functions",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run test/unit",
    "test:emulator:run": "vitest run test/emulator",
    "test:emulator": "npm run build && cd .. && firebase emulators:exec --project demo-ctx --only auth,firestore,storage,functions \"npm --prefix functions run test:emulator:run\"",
    "test": "npm run typecheck && npm run test:unit && npm run test:emulator"
  },
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "jose": "^6.2.17",
    "semver": "^7.7.0",
    "tar-stream": "^3.2.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.7.0",
    "@types/tar-stream": "^3.1.4",
    "firebase": "^13.3.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
