rules_version = '2';

// Read access to the registry index. Nothing is writable by clients: every change goes
// through the API (Admin SDK, which bypasses these rules).
//
//   packages/{name}                  what readers see
//   packages/{name}/private/access   who may read and maintain; maintainers only
//   grants/{id}                      one entry per reader, domain or maintainer; readable
//                                    only by whom it names
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function domain() {
      return email().split('@')[1];
    }

    // The access document of a package. Rules may look it up; clients that are not
    // maintainers never receive it.
    function accessOf(name) {
      return get(/databases/$(database)/documents/packages/$(name)/private/access).data;
    }

    function listedIn(access) {
      return signedIn() && (
        email() in access.readers
        || email() in access.maintainers
        || domain() in access.readerDomains
      );
    }

    function canRead(name) {
      return accessOf(name).visibility == 'public' || listedIn(accessOf(name));
    }

    match /packages/{name} {
      allow get: if resource.data.visibility == 'public' || listedIn(accessOf(name));
      // Listing is limited to public packages; what is shared with someone is found
      // through their grants.
      allow list: if resource.data.visibility == 'public';
      allow write: if false;

      match /versions/{version} {
        allow read: if canRead(name);
        allow write: if false;
      }

      match /private/access {
        allow get: if signedIn() && email() in resource.data.maintainers;
        allow list, write: if false;
      }
    }

    match /grants/{grant} {
      allow read: if signedIn() && (
        (resource.data.kind in ['reader', 'maintainer'] && resource.data.principal == email())
        || (resource.data.kind == 'domain' && resource.data.principal == domain())
      );
      allow write: if false;
    }

    // Registry configuration (who may create packages) is server-side only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
